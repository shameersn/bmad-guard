# Stack passwords for the guard event stack. Copy this file to "secrets.local.ini" and replace every value.
# "secrets.local.ini" is git-ignored. Never commit real values.
# Use letters, digits, "-" and "_" only (the values go into SQL and shell).
# "python3 keys.py init" can create the file with random values instead.
CLICKHOUSE_ADMIN_PASSWORD=change-me-admin
CLICKHOUSE_WRITER_PASSWORD=change-me-writer
CLICKHOUSE_READER_PASSWORD=change-me-reader
GRAFANA_ADMIN_PASSWORD=change-me-grafana
