#!/usr/bin/env python3
# /// script
# requires-python = ">=3.10"
# ///
"""Git pre-push hook of bmad-guard (Phase 2, T7). Installed in _bmad/custom/guard/hooks/ by scripts/setup_guard.py.

Plain Python, no Node, no Husky. It only starts the check in guard_pre_push.py (same folder), and blocks the push
when the check cannot start (fail closed). What it checks and the rule ids: see guard_pre_push.py and
module/hooks/README.md.
Git gives it the remote name and URL as arguments and one line per ref on stdin.
Exit 0: the push may go ahead. Exit 1: the push is blocked, the reasons are on stderr.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # no __pycache__ folders inside the project
sys.path.insert(0, str(Path(__file__).resolve().parent))


def main() -> int:
    if sys.version_info < (3, 10):  # noqa: UP036 - the macOS system python3 can be 3.9: say so, in plain words
        found = f"{sys.version_info[0]}.{sys.version_info[1]}"
        print(
            f"bmad-guard pre-push: the push is blocked: this hook needs Python 3.10 or later, and {sys.executable} "
            f"is {found}. Put a newer python3 first in your PATH.",
            file=sys.stderr,
        )
        return 1
    try:
        import guard_pre_push
    except BaseException as err:  # a hook that cannot load must block, not wave the push through
        print(
            f"bmad-guard pre-push: the push is blocked: the check cannot start ({type(err).__name__}).",
            file=sys.stderr,
        )
        print("Run scripts/setup_guard.py from the bmad-guard module again to repair the hooks.", file=sys.stderr)
        return 1
    return guard_pre_push.main()


sys.exit(main())
