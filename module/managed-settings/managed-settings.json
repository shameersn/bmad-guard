{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/skills/tool-guard/scripts/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/skills/prompt-guard/scripts/prompt_guard_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/skills/tool-guard/scripts/pre_tool_use.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(id_rsa*)",
      "Read(id_dsa*)",
      "Read(id_ecdsa*)",
      "Read(id_ed25519*)",
      "Read(*.p12)",
      "Read(*dump*.sql)",
      "Read(*.sql.bak)",
      "Read(*.db.bak)",
      "Read(*.sqlite.bak)",
      "Read(*.sqlite3.bak)",
      "Read(*dump*.bak)",
      "Read(*database*.bak)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/bmad-guard/**)"
    ]
  },
  "allowManagedHooksOnly": true
}
